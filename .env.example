# Build-time (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Runtime (server only — never commit values)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=
APP_USER_CONNECTION_KEY_SECRET=
# Agent scheduler (random 32+ chars) and run interval
AGENT_TICK_SECRET=
AGENT_INTERVAL_SECONDS=900
# Gmail connection-handle encryption key: openssl rand -base64 32
# (APP_USER_CONNECTION_KEY_SECRET above)
# Optional automatic Gmail updates (the service account is required for push to be accepted)
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
# Optional portal helper: comma-separated domains it may open, e.g. lever.co,greenhouse.io
PORTAL_ALLOWED_HOSTS=
