# ---------- Supabase (Project Settings → API) ----------
# Build-time and public: baked into the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Runtime and server-only: never commit real values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this app, no trailing slash (used for the Gmail sign-in redirect)
APP_URL=http://localhost:3000

# ---------- Access control ----------
# Optional: only these people may use this instance. Comma-separated addresses or @domain entries,
# e.g. me@example.com,@mycompany.com. Empty allows anyone who can sign in.
ALLOWED_EMAILS=

# ---------- AI: any OpenAI-compatible Chat Completions API ----------
# OpenAI     https://api.openai.com/v1
# OpenRouter https://openrouter.ai/api/v1
# Gemini     https://generativelanguage.googleapis.com/v1beta/openai
# Ollama     http://localhost:11434/v1  (from Docker: http://host.docker.internal:11434/v1)
AI_BASE_URL=
AI_MODEL=
# Not needed for a local server such as Ollama
AI_API_KEY=
# Optional: json_schema (default) | json_object | none
AI_RESPONSE_FORMAT=
# Optional: reasoning effort for models that accept it (e.g. low), and request timeout in ms
AI_REASONING_EFFORT=
AI_TIMEOUT_MS=

# ---------- Job-page reading (Firecrawl) ----------
FIRECRAWL_API_KEY=
# Optional: your own Firecrawl instance instead of https://api.firecrawl.dev
FIRECRAWL_API_URL=

# ---------- Gmail (Google Cloud OAuth client, type "Web application") ----------
# Authorized redirect URI: <APP_URL>/oauth/gmail/return
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Gmail tokens: openssl rand -base64 32
APP_USER_CONNECTION_KEY_SECRET=
# Optional automatic Gmail updates (Pub/Sub); pushes are rejected unless the service account is set
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# ---------- Background agent ----------
# Protects the scheduler endpoint: openssl rand -hex 32
AGENT_TICK_SECRET=
AGENT_INTERVAL_SECONDS=900

# ---------- Optional portal helper ----------
# Comma-separated domains it may open, e.g. lever.co,greenhouse.io,myworkdayjobs.com
PORTAL_ALLOWED_HOSTS=
